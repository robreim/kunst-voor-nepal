---
import PayModalContent from './PayModalContent.astro';

interface Props {
  /** Piece number. */
  number: number;
  /** Path to the QR image. */
  qr: string;
  /** Tikkie pay link. */
  payUrl: string;
}
const { number, qr, payUrl } = Astro.props;
---

<dialog class="pay-modal" aria-labelledby="pay-title">
  <form method="dialog" class="pay-modal__close-wrap">
    <button class="pay-modal__close" aria-label="Sluiten">✕</button>
  </form>
  <h2 id="pay-title" class="pay-modal__title">Betaal met Tikkie</h2>
  <p class="pay-modal__piece">Kunstwerk nr. {number}</p>
  <PayModalContent qr={qr} payUrl={payUrl} number={number} />
</dialog>
