<dialog class="art-modal" aria-labelledby="art-modal-title">
  <form method="dialog" class="art-modal__close-wrap">
    <button class="art-modal__close" aria-label="Sluiten">✕</button>
  </form>
  <div class="art-modal__inner">
    <img class="art-modal__img" id="art-modal-img" alt="" />
    <div class="art-modal__info">
      <p class="art-modal__number" id="art-modal-number"></p>
      <h2 id="art-modal-title" class="art-modal__title"></h2>
      <p class="art-modal__artist" id="art-modal-artist"></p>
      <p class="art-modal__dimensions" id="art-modal-dimensions"></p>
      <p class="art-modal__material" id="art-modal-material"></p>
      <p class="art-modal__price" id="art-modal-price"></p>
      <div class="art-modal__description" id="art-modal-description"></div>
    </div>
  </div>
</dialog>
