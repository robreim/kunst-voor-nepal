---
import { getCollection } from 'astro:content';
import ArtGrid from '../components/ArtGrid.astro';
import ArtworkModal from '../components/ArtworkModal.astro';

const settings = (await getCollection('settings'))[0].data;
const story = (await getCollection('story'))[0];
const { title, lead } = story.data;
const { Content } = await story.render();
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Kunst voor Nepal — verkoop van kunst voor de slachtoffers van de overstromingen</title>
    <meta
      name="description"
      content="Een groep kunstenaars verkoopt kunst om geld in te zamelen voor de slachtoffers van de overstromingen in Nepal. Alle opbrengsten gaan rechtstreeks naar de getroffenen."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Caveat:wght@400..700&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..700;1,8..60,300..700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🇳🇵</text></svg>" />
    <script is:inline>
      // Loginmagie: een e-mail-link met een inlogtoken die op de homepage belandt,
      // stuurt door naar /admin waar de token wordt afgehandeld.
      if ((location.hash || '').match(/(recovery|invite)_token=/)) {
        location.replace('/admin' + location.hash);
      }

      // Open the artwork detail modal when a card (image or body) is clicked.
      document.addEventListener('click', (event) => {
        const artEl = event.target.closest('.art-open');
        if (!artEl) return;
        const modal = document.querySelector('.art-modal');
        if (!modal) return;
        modal.querySelector('#art-modal-img').src = artEl.dataset.artImage;
        modal.querySelector('#art-modal-img').alt = `${artEl.dataset.artTitle} — ${artEl.dataset.artArtist}`;
        modal.querySelector('#art-modal-title').textContent = artEl.dataset.artTitle;
        modal.querySelector('#art-modal-number').textContent = `nr. ${artEl.dataset.artNumber}`;
        modal.querySelector('#art-modal-artist').textContent = artEl.dataset.artArtist;
        modal.querySelector('#art-modal-dimensions').textContent = artEl.dataset.artDimensions;
        modal.querySelector('#art-modal-material').textContent = artEl.dataset.artMaterial;
        modal.querySelector('#art-modal-price').textContent = artEl.dataset.artPrice;
        modal.querySelector('#art-modal-description').textContent = artEl.dataset.artDescription;
        modal.showModal();
      });

      document.querySelectorAll('.art-modal__close').forEach((btn) => {
        btn.addEventListener('click', () => btn.closest('dialog').close());
      });
    </script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header class="site-header">
      <nav class="site-nav" aria-label="Hoofdnavigatie">
        <a href="/" class="site-nav__brand">{settings.siteTitle}</a>
        <div class="site-nav__links">
          <a href="/#verhaal">Verhaal</a>
          <a href="/galerij">Galerij</a>
          <a href="/doneer" class="btn btn--sticker">Doneer</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero" id="verhaal">
        <h1 class="hero__title">
          <span class="hero__title-line">{title}</span>
        </h1>
        <p class="hero__lead">{lead}</p>
        <div class="hero__cta">
          <a href="/galerij" class="btn btn--ink">Bekijk de galerij</a>
          <a href="/doneer" class="btn btn--ember">Doneer direct</a>
        </div>
      </section>

      <section class="story" aria-label="Het verhaal">
        <div class="story__body">
          <div class="prose"><Content /></div>
        </div>
      </section>

      <section class="gallery" aria-label="Galerij">
        <div class="gallery__head">
          <h2>Uit de galerij</h2>
          <a href="/galerij" class="btn btn--sticker">Alle kunstwerken</a>
        </div>
        <ArtGrid limit={3} />
        <div class="gallery__foot">
          <a href="/doneer" class="btn btn--sticker">Doneer</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p class="site-footer__note">{settings.footerNote}</p>
      <p class="site-footer__contact">
        Contact: <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>
      </p>
      <p class="site-footer__love">met liefde voor Nepal ✦</p>
    </footer>

    <ArtworkModal />
  </body>
</html>
